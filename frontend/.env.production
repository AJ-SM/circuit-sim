# Used by `npm run build` (vite build). Local `npm run dev` ignores this file
# and keeps talking to the backend on port 8000.
# The backend sits behind nginx at https://nexalaya.tech/circuit-api/.
# /job and /detect-components are derived from VITE_GENERATE_URL.
VITE_SIMULATE_URL=https://nexalaya.tech/circuit-api/simulate
VITE_GENERATE_URL=https://nexalaya.tech/circuit-api/generate-circuit
